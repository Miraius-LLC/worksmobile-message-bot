{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["bun"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    ".tmp",
    /* develop-meta:jsonc-managed start tsconfig-exclude-develop-tools a0c2f7f99b3c54b321bdbc8cf1e9cac6f3a6abaa75e74091c29e11bf59917902 */
    "scripts/develop-tools/**"
    /* develop-meta:jsonc-managed end tsconfig-exclude-develop-tools a0c2f7f99b3c54b321bdbc8cf1e9cac6f3a6abaa75e74091c29e11bf59917902 */
  ]
}
