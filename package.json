{
  "name": "worksmobile-message-bot",
  "version": "0.0.0",
  "description": "Webhook bot messenger for LINE WORKS",
  "homepage": "http://miraius.co.jp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Miraius-LLC/worksmobile-message-bot.git"
  },
  "author": {
    "name": "Ayumi Fujii",
    "url": "https://github.com/fujimogn",
    "email": "fujimogn@gmail.com"
  },
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "secrets:inject": "$HOME/Develop/develop-meta/bin/develop-secrets --declaration .config/develop-secrets.jsonc --repo-root .",
    "secrets:check": "$HOME/Develop/develop-meta/bin/develop-secrets --declaration .config/develop-secrets.jsonc --repo-root . --check",
    "dev": "bun run --hot ./src/index.ts",
    "start": "bun run ./build/index.js",
    "build": "bun build ./src/index.ts --outdir=./build --target=bun --minify",
    "test": "bun test",
    "typecheck": "bun --check",
    "check": "bun run spec:validate && bun run typecheck && bun run lint && bun run test",
    "lint": "bunx biome check ./src ./tests ./scripts ci-config.test.ts ci-install.test.ts lockfile-config.test.ts wrangler-config.test.ts operations-config.test.ts openspec-config.test.ts openspec-adr-coverage.test.ts",
    "format": "bunx biome check --write ./src ./tests ./scripts",
    "spec": "OPENSPEC_TELEMETRY=0 openspec",
    "spec:validate": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "docker:build": "docker build -t worksmobile-message-bot .",
    "docker:run": "docker run -p 8080:8080 --env-file=.env worksmobile-message-bot",
    "lefthook:install": "lefthook install",
    "ci:install": "./scripts/ci-install.sh --frozen-lockfile",
    "test:fast": "bun test --path-ignore-patterns \"**/_fetch.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@fission-ai/openspec": "1.14.1",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "bun-types": "^1.4.4",
    "lefthook": "^2.2.2",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "wrangler": "4.149.0"
  },
  "license": "MIT"
}
